                    <span>🏆</span>
                    <span>جدول رده‌بندی</span>
                </a>
                <a href="{% url 'grandprix_calendar:calendar_list' %}" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-zinc-300 hover:text-white hover:bg-zinc-800/80 transition">
                    <span>📅</span>
                    <span>تقویم مسابقات</span>
                </a>
                <a href="{% url 'racing:drivers_list' %}" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-zinc-300 hover:text-white hover:bg-zinc-800/80 transition">
                    <span>🏎️</span>
                    <span>رانندگان</span>
                </a>
                <a href="{% url 'racing:teams_list' %}" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-zinc-300 hover:text-white hover:bg-zinc-800/80 transition">
                    <span>🏁</span>
                    <span>تیم‌ها</span>
                </a>
