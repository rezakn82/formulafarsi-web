            {% endif %}
            <span class="text-xs text-zinc-400">{{ article.created_at|jalali_date:"l j F Y" }} - ساعت {{ article.created_at|date:"H:i" }}</span>
        </div>

        <h1 class="text-2xl md:text-4xl font-black text-white leading-tight">
            {{ article.title }}
        </h1>

        <div class="flex items-center justify-between border-y border-zinc-800 py-3 text-xs text-zinc-400">
            <div class="flex items-center gap-2">
                <span class="w-7 h-7 rounded-full bg-zinc-800 border border-zinc-700 flex items-center justify-center font-bold text-red-500">
                    {{ article.author.username|slice:":1"|upper }}
                </span>
                <span>نویسنده: <strong class="text-zinc-200">{{ article.author.get_full_name|default:article.author.username }}</strong></span>
            </div>

            <!-- دکمه اشتراک‌گذاری در کانال/گروه تلگرام -->
            <a href="https://t.me/share/url?url={{ request.build_absolute_uri }}&text={{ article.title|urlencode }}" 
               target="_blank" 
               class="flex items-center gap-1.5 bg-[#229ED9]/10 text-[#229ED9] hover:bg-[#229ED9]/20 px-3 py-1.5 rounded-lg border border-[#229ED9]/30 transition">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.52 2.77-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/></svg>
                <span>اشتراک در تلگرام</span>
            </a>
        </div>
    </div>

    <!-- تصویر شاخص -->
    {% if article.featured_image %}
    <div class="rounded-2xl overflow-hidden border border-zinc-800 shadow-2xl bg-zinc-900 aspect-video">
        <img src="{{ article.featured_image.url }}" alt="{{ article.title }}" class="w-full h-full object-cover">
    </div>
    {% endif %}

    <!-- لید خبر -->
    <div class="bg-zinc-900/60 border-r-4 border-red-600 p-4 rounded-l-xl text-zinc-300 font-medium text-base leading-relaxed">
        {{ article.lead }}
