</file>

<file path="templates/grandprix_calendar/grandprix_detail.html">
{% extends 'base.html' %}

{% block title %}{{ grand_prix.name }} | برنامه زمانی، پیست و نتایج{% endblock %}

{% block content %}
<div class="space-y-8 max-w-5xl mx-auto">

    <!-- دکمه بازگشت -->
    <a href="{% url 'grandprix_calendar:calendar_list' %}?season={{ grand_prix.season.year }}" class="inline-flex items-center gap-1 text-xs text-zinc-400 hover:text-white transition">
        ← بازگشت به تقویم فصل {{ grand_prix.season.year }}
    </a>

    <!-- بنر معرفی گرندپری -->
    <div class="bg-gradient-to-r from-zinc-900 to-zinc-900/60 border border-zinc-800 rounded-2xl p-6 md:p-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
            <span class="text-xs font-bold text-red-500 bg-red-950/40 border border-red-900/50 px-2.5 py-1 rounded-md">راند {{ grand_prix.round_number }} - فصل {{ grand_prix.season.year }}</span>
            <h1 class="text-2xl md:text-4xl font-black text-white mt-3">{{ grand_prix.name }}</h1>
            <p class="text-sm text-zinc-400 mt-2">برگزارکننده: پیست {{ grand_prix.circuit.name }}، {{ grand_prix.circuit.country }}</p>
        </div>
        <div class="text-left md:text-right bg-zinc-950/50 border border-zinc-800/80 p-4 rounded-xl">
            <span class="text-[11px] text-zinc-500 block">تاریخ آخر هفته:</span>
            <span class="text-sm font-bold text-zinc-200 mt-1 block">{{ grand_prix.start_date|jalali_date:"j F" }} تا {{ grand_prix.end_date|jalali_date:"j F Y" }}</span>
        </div>
    </div>

    <!-- آرشیو نتایج جلسات برگزار شده (تمرینی، تعیین خط، اسپرینت و مسابقه) -->
    {% if sessions_with_results %}
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 space-y-6 shadow-xl">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-zinc-800 pb-4">
            <h2 class="text-lg font-bold text-white flex items-center gap-2">
                <span class="w-1.5 h-5 bg-red-600 rounded-sm"></span>
                نتایج جلسات برگزار شده
            </h2>

            <!-- تب‌های انتخاب سشن -->
            <div class="flex items-center gap-2 overflow-x-auto pb-1 text-xs font-bold">
                {% for session in sessions_with_results %}
                <button type="button"
                        id="session-btn-{{ session.id }}"
                        onclick="showSessionResult('{{ session.id }}')"
                        class="session-tab-btn px-4 py-2 rounded-xl border whitespace-nowrap transition {% if forloop.last %}bg-red-600 border-red-600 text-white{% else %}bg-zinc-950 border-zinc-800 text-zinc-400 hover:text-white{% endif %}">
                    {{ session.get_session_type_display }}
                </button>
                {% endfor %}
            </div>
        </div>

        <!-- جداول نتایج هر سشن (به صورت پیش‌فرض آخرین سشن برگزار شده مثل مسابقه اصلی فعال است) -->
        {% for session in sessions_with_results %}
        <div id="session-panel-{{ session.id }}" class="session-result-panel {% if not forloop.last %}hidden{% endif %}">
            <div class="overflow-x-auto rounded-xl border border-zinc-800">
                <table class="w-full text-right text-sm">
                    <thead class="bg-zinc-950/90 text-zinc-400 text-xs border-b border-zinc-800">
                        <tr>
                            <th class="py-3.5 px-4 text-center w-14">رتبه</th>
                            <th class="py-3.5 px-4">راننده</th>
                            <th class="py-3.5 px-4">تیم</th>

                            {% if session.session_type == 'qualifying' or session.session_type == 'sprint_shootout' %}
                                <th class="py-3.5 px-4 text-center font-mono">Q1 / SQ1</th>
                                <th class="py-3.5 px-4 text-center font-mono">Q2 / SQ2</th>
                                <th class="py-3.5 px-4 text-center font-mono">Q3 / SQ3</th>
                            {% else %}
                                {% if session.session_type == 'race' or session.session_type == 'sprint' %}
                                <th class="py-3.5 px-4 text-center">خط شروع</th>
                                {% endif %}
                                <th class="py-3.5 px-4 text-center">دورها</th>
                                <th class="py-3.5 px-4 text-left font-mono">زمان / فاصله</th>
                            {% endif %}

                            {% if session.session_type == 'race' or session.session_type == 'sprint' %}
                                <th class="py-3.5 px-4 text-left font-mono">امتیاز</th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-800/80 font-medium">
                        {% for res in session.results.all %}
                        <tr class="hover:bg-zinc-800/40 transition">
                            <!-- ستون رتبه یا وضعیت DNF/DSQ -->
                            <td class="py-3.5 px-4 text-center font-mono font-bold">
                                {% if res.status == 'finished' %}
                                    <span class="{% if res.position == 1 %}text-amber-400 text-base{% elif res.position == 2 %}text-zinc-300 text-base{% elif res.position == 3 %}text-amber-600 text-base{% else %}text-zinc-400{% endif %}">
                                        {{ res.position|floatformat }}
                                    </span>
                                {% else %}
                                    <span class="text-[11px] bg-red-950/60 text-red-400 border border-red-800/50 px-2 py-0.5 rounded uppercase">
                                        {{ res.status }}
                                    </span>
                                {% endif %}
                            </td>

                            <!-- ستون راننده -->
                            <td class="py-3.5 px-4">
                                <a href="{% url 'racing:driver_detail' res.driver.code %}" class="flex items-center gap-2.5 group">
                                    <span class="w-1.5 h-5 rounded-full" style="background-color: {{ res.team.color_code|default:'#52525b' }};"></span>
                                    <span class="text-white font-bold group-hover:text-red-400 transition">{{ res.driver.full_name }}</span>
                                    <span class="text-[10px] text-zinc-500 font-mono">#{{ res.driver.permanent_number }}</span>
                                    {% if res.fastest_lap %}
                                    <span title="سریع‌ترین دور" class="text-[10px] bg-purple-950/80 text-purple-300 border border-purple-700/60 px-1.5 py-0.5 rounded font-mono">FL</span>
                                    {% endif %}
                                </a>
                            </td>

                            <!-- ستون تیم -->
                            <td class="py-3.5 px-4 text-xs text-zinc-300">
                                <a href="{% url 'racing:team_detail' res.team.pk %}" class="hover:text-white transition">
                                    {{ res.team.name }}
                                </a>
                            </td>

                            <!-- ستون‌های متغیر بر اساس نوع جلسه -->
                            {% if session.session_type == 'qualifying' or session.session_type == 'sprint_shootout' %}
                                <td class="py-3.5 px-4 text-center font-mono text-xs text-zinc-300">{{ res.q1_time|default:"-" }}</td>
                                <td class="py-3.5 px-4 text-center font-mono text-xs text-zinc-300">{{ res.q2_time|default:"-" }}</td>
                                <td class="py-3.5 px-4 text-center font-mono text-xs font-bold text-emerald-400">{{ res.q3_time|default:"-" }}</td>
                            {% else %}
                                {% if session.session_type == 'race' or session.session_type == 'sprint' %}
                                <td class="py-3.5 px-4 text-center font-mono text-xs text-zinc-400">{{ res.grid_position|default:"-" }}</td>
                                {% endif %}
                                <td class="py-3.5 px-4 text-center font-mono text-xs text-zinc-400">{{ res.laps }}</td>
                                <td class="py-3.5 px-4 text-left font-mono text-xs text-zinc-200" dir="ltr">{{ res.time_or_gap|default:"-" }}</td>
                            {% endif %}

                            {% if session.session_type == 'race' or session.session_type == 'sprint' %}
                                <td class="py-3.5 px-4 text-left font-mono font-black text-white">
                                    {% if res.points > 0 %}+{{ res.points|floatformat }}{% else %}0{% endif %}
                                </td>
                            {% endif %}
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

    <!-- جدول زمان‌بندی جلسات (سشن‌ها) -->
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 space-y-4">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <span class="w-1.5 h-5 bg-red-600 rounded-sm"></span>
            برنامه زمانی تمام جلسات (به وقت ایران)
        </h2>

        <div class="divide-y divide-zinc-800">
            {% for session in sessions %}
            <div class="py-3.5 flex items-center justify-between text-sm">
                <div class="flex items-center gap-3">
                    <span class="w-2 h-2 rounded-full {% if session.start_time < now %}bg-zinc-600{% else %}bg-red-500{% endif %}"></span>
                    <span class="font-bold text-zinc-200">{{ session.get_session_type_display }}</span>
                </div>
                <div class="flex items-center gap-4 text-xs md:text-sm font-mono text-zinc-400">
                    <span>{{ session.start_time|jalali_date:"l j F" }}</span>
                    <span class="bg-zinc-800 text-white px-2.5 py-1 rounded-md font-bold">{{ session.start_time|date:"H:i" }}</span>
                </div>
            </div>
            {% empty %}
            <p class="text-zinc-500 text-xs py-3">هنوز زمان‌بندی سشن‌ها وارد نشده است.</p>
            {% endfor %}
        </div>
    </div>

    <!-- مشخصات و نقشه پیست -->
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 space-y-6">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <span class="w-1.5 h-5 bg-red-600 rounded-sm"></span>
            اطلاعات پیست: {{ grand_prix.circuit.name }}
        </h2>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="bg-zinc-950/60 p-4 rounded-xl border border-zinc-800/80 text-center">
                <span class="text-xs text-zinc-500 block">طول پیست</span>
                <span class="text-lg font-bold text-white mt-1 block font-mono">{{ grand_prix.circuit.length_km }} km</span>
            </div>
            <div class="bg-zinc-950/60 p-4 rounded-xl border border-zinc-800/80 text-center">
                <span class="text-xs text-zinc-500 block">تعداد پیچ‌ها</span>
                <span class="text-lg font-bold text-white mt-1 block font-mono">{{ grand_prix.circuit.corners }}</span>
            </div>
            <div class="bg-zinc-950/60 p-4 rounded-xl border border-zinc-800/80 text-center col-span-2">
                <span class="text-xs text-zinc-500 block">رکورد پیست</span>
                <span class="text-sm font-bold text-red-400 mt-1 block font-mono">{{ grand_prix.circuit.lap_record|default:"ثبت نشده" }}</span>
            </div>
        </div>

        {% if grand_prix.circuit.image %}
        <div class="rounded-xl overflow-hidden border border-zinc-800 bg-zinc-950 p-4 flex items-center justify-center">
            <img src="{{ grand_prix.circuit.image.url }}" alt="{{ grand_prix.circuit.name }}" class="max-h-96 object-contain">
        </div>
        {% endif %}
    </div>

</div>
{% endblock %}

{% block extra_js %}
<script>
    function showSessionResult(sessionId) {
        document.querySelectorAll('.session-result-panel').forEach(panel => {
            panel.classList.add('hidden');
        });
        document.querySelectorAll('.session-tab-btn').forEach(btn => {
            btn.className = "session-tab-btn px-4 py-2 rounded-xl border whitespace-nowrap transition bg-zinc-950 border-zinc-800 text-zinc-400 hover:text-white";
        });

        const activePanel = document.getElementById('session-panel-' + sessionId);
        const activeBtn = document.getElementById('session-btn-' + sessionId);
        if (activePanel) activePanel.classList.remove('hidden');
        if (activeBtn) {
            activeBtn.className = "session-tab-btn px-4 py-2 rounded-xl border whitespace-nowrap transition bg-red-600 border-red-600 text-white";
        }
    }
</script>
{% endblock %}
</file>

<file path="templates/news/articles_list.html">
{% extends 'base.html' %}

{% block title %}آرشیو اخبار فرمول یک | آخرین رویدادها{% endblock %}

{% block content %}
<div class="space-y-8">

    <!-- سربرگ -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-zinc-800 pb-6">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span class="w-2 h-2 rounded-full bg-red-600"></span>
                <span class="text-xs uppercase font-bold text-red-500 tracking-wider">LATEST UPDATES</span>
            </div>
            <h1 class="text-2xl md:text-3xl font-black text-white">آرشیو اخبار و مقالات</h1>
        </div>
    </div>
    
    <!-- تب‌های فیلتر دسته‌بندی -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none text-xs">
        <a href="{% url 'news:articles_list' %}" 
           class="px-4 py-2 rounded-xl border whitespace-nowrap transition {% if not selected_category %}bg-red-600 border-red-600 text-white font-bold{% else %}bg-zinc-900 border-zinc-800 text-zinc-400 hover:border-zinc-700{% endif %}">
            همه اخبار
        </a>
        {% for cat in categories %}
        <a href="{% url 'news:articles_list' %}?category={{ cat.slug }}{% if search_query %}&q={{ search_query }}{% endif %}" 
           class="px-4 py-2 rounded-xl border whitespace-nowrap transition {% if selected_category == cat.slug %}bg-red-600 border-red-600 text-white font-bold{% else %}bg-zinc-900 border-zinc-800 text-zinc-400 hover:border-zinc-700{% endif %}">
            {{ cat.title }}
        </a>
        {% endfor %}
    </div>

    <!-- نمایش وضعیت جستجو -->
    {% if search_query %}
    <div class="flex items-center justify-between text-xs text-zinc-400 bg-zinc-900/50 p-3 rounded-lg border border-zinc-800">
        <span>نتایج جستجو برای: <strong class="text-white">"{{ search_query }}"</strong></span>
        <a href="{% url 'news:articles_list' %}" class="text-red-500 hover:underline">پاک کردن جستجو</a>
    </div>
    {% endif %}

    <!-- گرید ۳ ستونه کارت‌های اخبار -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for article in page_obj %}
        <a href="{{ article.get_absolute_url }}" 
           class="bg-zinc-900 border border-zinc-800 hover:border-zinc-700 rounded-2xl overflow-hidden transition group flex flex-col justify-between shadow-lg">
            <div>
                {% if article.featured_image %}
                <div class="aspect-video w-full overflow-hidden bg-zinc-950">
                    <img src="{{ article.featured_image.url }}" alt="{{ article.title }}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                </div>
                {% endif %}

                <div class="p-5">
                    {% if article.category %}
                    <span class="text-[11px] bg-red-600/10 text-red-500 border border-red-500/20 px-2.5 py-0.5 rounded font-bold">
                        {{ article.category.title }}
                    </span>
                    {% endif %}
                    <h3 class="text-base font-bold text-white mt-2.5 group-hover:text-red-400 transition line-clamp-2 leading-snug">
                        {{ article.title }}
                    </h3>
                    <p class="text-xs text-zinc-400 mt-2 line-clamp-2 leading-relaxed">
                        {{ article.lead }}
                    </p>
                </div>
            </div>

            <div class="px-5 py-3 border-t border-zinc-800/80 bg-zinc-950/40 flex items-center justify-between text-[11px] text-zinc-500">
                <span>{{ article.author.get_full_name|default:article.author.username }}</span>
                <span>{{ article.created_at|jalali_date:"j F Y" }}</span>
            </div>
        </a>
        {% empty %}
        <div class="col-span-full text-center py-16 bg-zinc-900/40 rounded-2xl border border-zinc-800 text-zinc-500">
            هیچ خبری متناسب با انتخاب شما یافت نشد.
        </div>
        {% endfor %}
    </div>

    <!-- کنترل صفحه‌بندی (Pagination) -->
    {% if page_obj.has_other_pages %}
    <div class="flex items-center justify-center gap-2 pt-8 border-t border-zinc-800 text-xs">
        {% if page_obj.has_previous %}
        <a href="?page={{ page_obj.previous_page_number }}{% if selected_category %}&category={{ selected_category }}{% endif %}{% if search_query %}&q={{ search_query }}{% endif %}" 
           class="px-3 py-2 bg-zinc-900 border border-zinc-800 rounded-lg hover:border-zinc-700 text-zinc-300">
            قبلی
        </a>
        {% endif %}

        <span class="px-4 py-2 bg-zinc-800 border border-zinc-700 rounded-lg text-white font-bold font-mono">
            صفحه {{ page_obj.number }} از {{ page_obj.paginator.num_pages }}
        </span>

        {% if page_obj.has_next %}
        <a href="?page={{ page_obj.next_page_number }}{% if selected_category %}&category={{ selected_category }}{% endif %}{% if search_query %}&q={{ search_query }}{% endif %}" 
           class="px-3 py-2 bg-zinc-900 border border-zinc-800 rounded-lg hover:border-zinc-700 text-zinc-300">
            بعدی
        </a>
        {% endif %}
    </div>
    {% endif %}

</div>
{% endblock %}
</file>

<file path="templates/racing/driver_detail.html">
{% extends 'base.html' %}

{% block title %}{{ driver.full_name }} (#{{ driver.permanent_number }}) | پروفایل راننده{% endblock %}

{% block content %}
<div class="space-y-8 max-w-5xl mx-auto">

    <!-- دکمه بازگشت -->
    <a href="{% url 'racing:drivers_list' %}" class="inline-flex items-center gap-1 text-xs text-zinc-400 hover:text-white transition">
        ← بازگشت به لیست رانندگان
    </a>

    <!-- بنر اصلی راننده -->
    <div class="bg-gradient-to-r from-zinc-900 via-zinc-900 to-zinc-950 border border-zinc-800 rounded-3xl p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-8 relative overflow-hidden">
        
        <div class="space-y-4 z-10 w-full md:w-auto">
            <div class="flex items-center gap-3">
                <span class="text-4xl font-black font-mono italic text-red-500">#{{ driver.permanent_number }}</span>
                <span class="text-sm font-mono uppercase bg-zinc-800 border border-zinc-700 px-2.5 py-1 rounded text-zinc-300">{{ driver.code }}</span>
            </div>

            <div>
                <h1 class="text-3xl md:text-5xl font-black text-white leading-tight">{{ driver.full_name }}</h1>
                {% if driver.team %}
                <a href="{% url 'racing:team_detail' driver.team.pk %}" class="inline-flex items-center gap-2 text-sm text-zinc-400 hover:text-white mt-2 transition">
                    <span class="w-3 h-3 rounded-full inline-block" style="background-color: {{ driver.team.color_code }};"></span>
                    <span>راننده تیم <strong>{{ driver.team.name }}</strong></span>
                </a>
                {% endif %}
            </div>

            <div class="grid grid-cols-2 gap-4 pt-2 text-xs">
                <div class="bg-zinc-950/60 p-3 rounded-xl border border-zinc-800">
                    <span class="text-zinc-500 block">ملیت</span>
                    <span class="text-zinc-200 font-bold mt-1 block">{{ driver.country }}</span>
                </div>
                <div class="bg-zinc-950/60 p-3 rounded-xl border border-zinc-800">
                    <span class="text-zinc-500 block">تاریخ تولد</span>
                    <span class="text-zinc-200 font-bold mt-1 block font-mono">{{ driver.date_of_birth|jalali_date:"j F Y" }}</span>
                </div>
            </div>
        </div>

        <!-- تصویر بزرگ پرتره راننده -->
        {% if driver.portrait %}
        <div class="w-64 h-64 md:w-80 md:h-80 flex-shrink-0 flex items-end justify-center z-10">
            <img src="{{ driver.portrait.url }}" alt="{{ driver.full_name }}" class="max-h-full object-contain drop-shadow-2xl">
        </div>
        {% endif %}

        <div class="absolute -left-10 -bottom-10 opacity-5 text-9xl font-black italic pointer-events-none">{{ driver.code }}</div>
    </div>

    <!-- بیوگرافی راننده -->
    {% if driver.bio %}
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 space-y-3">
        <h3 class="text-lg font-bold text-white flex items-center gap-2">
            <span class="w-1.5 h-5 bg-red-600 rounded-sm"></span>
            بیوگرافی و سوابق
        </h3>
        <div class="text-zinc-300 text-sm leading-relaxed space-y-3">{{ driver.bio|safe }}</div>
    </div>
    {% endif %}

    <!-- اخبار مربوط به این راننده -->
    {% if related_articles %}
    <div class="space-y-4">
        <h3 class="text-lg font-bold text-white flex items-center gap-2">
            <span class="w-1.5 h-5 bg-red-600 rounded-sm"></span>
            آخرین اخبار درباره {{ driver.full_name }}
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {% for art in related_articles %}
            <a href="{{ art.get_absolute_url }}" class="bg-zinc-900 border border-zinc-800 rounded-xl p-3 hover:border-zinc-700 transition flex flex-col justify-between group">
                {% if art.featured_image %}
                <img src="{{ art.featured_image.url }}" alt="{{ art.title }}" class="rounded-lg aspect-video object-cover mb-3 bg-zinc-800">
                {% endif %}
                <h5 class="text-xs font-bold text-white group-hover:text-red-400 transition line-clamp-2">{{ art.title }}</h5>
                <span class="text-[10px] text-zinc-500 mt-3">{{ art.created_at|jalali_date:"j F Y" }}</span>
            </a>
            {% endfor %}
        </div>
    </div>
    {% endif %}

</div>
{% endblock %}
</file>

<file path="templates/racing/standings.html">
{% extends 'base.html' %}

{% block title %}جدول رده‌بندی مسابقات فرمول یک فصل {{ season.year }} | فرمولافارسی{% endblock %}

{% block content %}
<div class="space-y-6 max-w-5xl mx-auto">

    <!-- سربرگ -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-zinc-800 pb-5">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span class="w-2 h-2 rounded-full bg-red-600"></span>
                <span class="text-xs uppercase font-bold text-red-500 tracking-wider">CHAMPIONSHIP STANDINGS</span>
            </div>
            <h1 class="text-2xl md:text-3xl font-black text-white">جدول رده‌بندی و امتیازات فصل {{ season.year }}</h1>
        </div>

        <!-- دکمه‌های جابجایی تب‌ها -->
        <div class="inline-flex p-1 bg-zinc-900 border border-zinc-800 rounded-xl text-xs font-bold">
            <button id="tab-drivers-btn" onclick="showTab('drivers')" class="px-5 py-2 rounded-lg bg-red-600 text-white transition">
                رده‌بندی رانندگان
            </button>
            <button id="tab-teams-btn" onclick="showTab('teams')" class="px-5 py-2 rounded-lg text-zinc-400 hover:text-white transition">
                رده‌بندی تیمی (سازندگان)
            </button>
        </div>
    </div>

    <!-- ۱. جدول رده‌بندی رانندگان -->
    <div id="tab-drivers" class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden shadow-xl">
        <div class="overflow-x-auto">
            <table class="w-full text-right text-sm">
                <thead class="bg-zinc-950/80 text-zinc-400 text-xs border-b border-zinc-800">
                    <tr>
                        <th class="py-3.5 px-4 text-center w-14">رتبه</th>
                        <th class="py-3.5 px-4">راننده</th>
                        <th class="py-3.5 px-4">تیم</th>
                        <th class="py-3.5 px-4 text-center">بردها</th>
                        <th class="py-3.5 px-4 text-left font-mono">امتیاز کل</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800/80 font-medium">
                    {% for item in driver_standings %}
                    <tr class="hover:bg-zinc-800/40 transition">
                        <td class="py-4 px-4 text-center font-bold font-mono {% if item.position <= 3 %}text-red-500 text-base{% else %}text-zinc-400{% endif %}">
                            {{ item.position }}
                        </td>
                        <td class="py-4 px-4">
                            <a href="{% url 'racing:driver_detail' item.driver.code %}" class="flex items-center gap-3 group">
                                <span class="w-1.5 h-6 rounded-full" style="background-color: {{ item.driver.team.color_code|default:'#52525b' }};"></span>
                                {% if item.driver.portrait %}
                                <img src="{{ item.driver.portrait.url }}" alt="{{ item.driver.full_name }}" class="w-8 h-8 rounded-full object-cover bg-zinc-950 border border-zinc-700">
                                {% endif %}
                                <span class="text-white font-bold group-hover:text-red-400 transition">{{ item.driver.full_name }}</span>
                                <span class="text-[10px] text-zinc-500 font-mono">#{{ item.driver.permanent_number }}</span>
                            </a>
                        </td>
                        <td class="py-4 px-4 text-xs text-zinc-300">
                            {{ item.driver.team.name|default:"آزاد" }}
                        </td>
                        <td class="py-4 px-4 text-center font-mono text-zinc-400">
                            {{ item.wins }}
                        </td>
                        <td class="py-4 px-4 text-left font-mono font-black text-white text-base">
                            {{ item.points|floatformat }}
                        </td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="5" class="py-12 text-center text-zinc-500">اطلاعات رده‌بندی برای این فصل ثبت نشده است.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- ۲. جدول رده‌بندی تیمی (سازندگان) -->
    <div id="tab-teams" class="hidden bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden shadow-xl">
        <div class="overflow-x-auto">
            <table class="w-full text-right text-sm">
                <thead class="bg-zinc-950/80 text-zinc-400 text-xs border-b border-zinc-800">
                    <tr>
                        <th class="py-3.5 px-4 text-center w-14">رتبه</th>
                        <th class="py-3.5 px-4">تیم</th>
                        <th class="py-3.5 px-4">پیشرانه</th>
                        <th class="py-3.5 px-4 text-center">بردها</th>
                        <th class="py-3.5 px-4 text-left font-mono">امتیاز کل</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800/80 font-medium">
                    {% for item in team_standings %}
                    <tr class="hover:bg-zinc-800/40 transition">
                        <td class="py-4 px-4 text-center font-bold font-mono {% if item.position <= 3 %}text-red-500 text-base{% else %}text-zinc-400{% endif %}">
                            {{ item.position }}
                        </td>
                        <td class="py-4 px-4">
                            <a href="{% url 'racing:team_detail' item.team.pk %}" class="flex items-center gap-3 group">
                                <span class="w-1.5 h-6 rounded-full" style="background-color: {{ item.team.color_code|default:'#52525b' }};"></span>
                                {% if item.team.logo %}
                                <img src="{{ item.team.logo.url }}" alt="{{ item.team.name }}" class="h-6 max-w-[40px] object-contain">
                                {% endif %}
                                <span class="text-white font-bold group-hover:text-red-400 transition">{{ item.team.name }}</span>
                            </a>
                        </td>
                        <td class="py-4 px-4 text-xs text-zinc-300">
                            {{ item.team.power_unit }}
                        </td>
                        <td class="py-4 px-4 text-center font-mono text-zinc-400">
                            {{ item.wins }}
                        </td>
                        <td class="py-4 px-4 text-left font-mono font-black text-white text-base">
                            {{ item.points|floatformat }}
                        </td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="5" class="py-12 text-center text-zinc-500">اطلاعات رده‌بندی تیمی برای این فصل ثبت نشده است.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>
{% endblock %}

{% block extra_js %}
<script>
    function showTab(type) {
        const driversTab = document.getElementById('tab-drivers');
        const teamsTab = document.getElementById('tab-teams');
        const driversBtn = document.getElementById('tab-drivers-btn');
        const teamsBtn = document.getElementById('tab-teams-btn');

        if (type === 'drivers') {
            driversTab.classList.remove('hidden');
            teamsTab.classList.add('hidden');
            driversBtn.className = "px-5 py-2 rounded-lg bg-red-600 text-white transition";
            teamsBtn.className = "px-5 py-2 rounded-lg text-zinc-400 hover:text-white transition";
        } else {
            teamsTab.classList.remove('hidden');
            driversTab.classList.add('hidden');
            teamsBtn.className = "px-5 py-2 rounded-lg bg-red-600 text-white transition";
            driversBtn.className = "px-5 py-2 rounded-lg text-zinc-400 hover:text-white transition";
        }
    }
</script>
{% endblock %}
</file>

<file path="templates/racing/team_detail.html">
{% extends 'base.html' %}

{% block title %}تیم {{ team.name }} | پروفایل و مشخصات{% endblock %}

{% block content %}
<div class="space-y-8 max-w-5xl mx-auto">

    <!-- بازگشت -->
    <a href="{% url 'racing:teams_list' %}" class="inline-flex items-center gap-1 text-xs text-zinc-400 hover:text-white transition">
        ← بازگشت به لیست تیم‌ها
    </a>

    <!-- بنر معرفی تیم -->
    <div class="bg-gradient-to-r from-zinc-900 to-zinc-950 border border-zinc-800 rounded-3xl p-6 md:p-8 relative overflow-hidden">
        <div class="absolute top-0 right-0 left-0 h-2" style="background-color: {{ team.color_code }};"></div>

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pt-2">
            <div>
                <h1 class="text-3xl md:text-5xl font-black text-white">{{ team.name }}</h1>
                <p class="text-sm text-zinc-400 mt-1">{{ team.full_name|default:team.name }}</p>
            </div>
            {% if team.logo %}
            <img src="{{ team.logo.url }}" alt="{{ team.name }}" class="h-16 max-w-[140px] object-contain bg-zinc-900/80 p-2 rounded-xl border border-zinc-800">
            {% endif %}
        </div>

        <!-- مشخصات فنی تیم -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
            <div class="bg-zinc-950/60 p-3.5 rounded-xl border border-zinc-800 text-center">
                <span class="text-xs text-zinc-500 block">مقر اصلی</span>
                <span class="text-sm font-bold text-white mt-1 block">{{ team.base }}</span>
            </div>
            <div class="bg-zinc-950/60 p-3.5 rounded-xl border border-zinc-800 text-center">
                <span class="text-xs text-zinc-500 block">مدیر تیم</span>
                <span class="text-sm font-bold text-white mt-1 block">{{ team.team_chief }}</span>
            </div>
            <div class="bg-zinc-950/60 p-3.5 rounded-xl border border-zinc-800 text-center">
                <span class="text-xs text-zinc-500 block">پیشرانه</span>
                <span class="text-sm font-bold text-white mt-1 block">{{ team.power_unit }}</span>
            </div>
            <div class="bg-zinc-950/60 p-3.5 rounded-xl border border-zinc-800 text-center flex flex-col items-center justify-center">
                <span class="text-xs text-zinc-500 block">رنگ سازمانی</span>
                <span class="w-6 h-6 rounded-full border border-zinc-600 mt-1 block" style="background-color: {{ team.color_code }};"></span>
            </div>
        </div>

        {% if team.car_image %}
        <div class="mt-8 flex justify-center">
            <img src="{{ team.car_image.url }}" alt="{{ team.name }} car" class="max-h-60 object-contain drop-shadow-2xl">
        </div>
        {% endif %}
    </div>

    <!-- رانندگان این تیم -->
    <div class="space-y-4">
        <h3 class="text-lg font-bold text-white flex items-center gap-2">
            <span class="w-1.5 h-5 bg-red-600 rounded-sm"></span>
            رانندگان رسمی تیم {{ team.name }}
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {% for driver in drivers %}
            <a href="{% url 'racing:driver_detail' driver.code %}" class="bg-zinc-900 border border-zinc-800 hover:border-zinc-700 p-4 rounded-xl flex items-center justify-between transition group">
                <div class="flex items-center gap-4">
                    {% if driver.portrait %}
                    <img src="{{ driver.portrait.url }}" alt="{{ driver.full_name }}" class="w-14 h-14 object-contain rounded-lg bg-zinc-950 border border-zinc-800">
                    {% endif %}
                    <div>
                        <h4 class="text-base font-bold text-white group-hover:text-red-400 transition">{{ driver.full_name }}</h4>
                        <span class="text-xs text-zinc-400">{{ driver.country }}</span>
                    </div>
                </div>
                <span class="text-2xl font-black font-mono italic text-zinc-600">#{{ driver.permanent_number }}</span>
            </a>
            {% empty %}
            <p class="text-zinc-500 text-sm">هنوز راننده‌ای برای این تیم ثبت نشده است.</p>
            {% endfor %}
        </div>
    </div>

    <!-- بیوگرافی تیم -->
    {% if team.bio %}
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 space-y-3">
        <h3 class="text-lg font-bold text-white flex items-center gap-2">
            <span class="w-1.5 h-5 bg-red-600 rounded-sm"></span>
            درباره تیم
        </h3>
        <div class="text-zinc-300 text-sm leading-relaxed space-y-3">{{ team.bio|safe }}</div>
    </div>
    {% endif %}

    <!-- اخبار مربوط به این تیم -->
    {% if related_articles %}
    <div class="space-y-4">
        <h3 class="text-lg font-bold text-white flex items-center gap-2">
            <span class="w-1.5 h-5 bg-red-600 rounded-sm"></span>
            اخبار تیم {{ team.name }}
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {% for art in related_articles %}
            <a href="{{ art.get_absolute_url }}" class="bg-zinc-900 border border-zinc-800 rounded-xl p-3 hover:border-zinc-700 transition flex flex-col justify-between group">
                {% if art.featured_image %}
                <img src="{{ art.featured_image.url }}" alt="{{ art.title }}" class="rounded-lg aspect-video object-cover mb-3 bg-zinc-800">
                {% endif %}
                <h5 class="text-xs font-bold text-white group-hover:text-red-400 transition line-clamp-2">{{ art.title }}</h5>
                <span class="text-[10px] text-zinc-500 mt-3">{{ art.created_at|jalali_date:"j F Y" }}</span>
            </a>
            {% endfor %}
        </div>
    </div>
    {% endif %}

</div>
{% endblock %}
</file>

