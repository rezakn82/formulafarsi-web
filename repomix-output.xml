                <div class="relative w-full">
                    <input type="text" name="q" value="{{ search_query|default:'' }}"
                           placeholder="جستجو..."
                           class="w-full bg-zinc-950 border border-zinc-800 text-xs text-zinc-200 rounded-xl pr-3.5 pl-9 py-2.5 focus:outline-none focus:border-red-600 transition placeholder:text-zinc-500">
