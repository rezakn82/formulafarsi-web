{% extends 'base.html' %}

{% block title %}{{ article.title }} | پایگاه خبری فرمول یک{% endblock %}

{% block content %}
<article class="max-w-4xl mx-auto space-y-8">

    <!-- دسته‌بندی و اطلاعات انتشار -->
    <div class="space-y-3">
        <div class="flex items-center gap-3">
