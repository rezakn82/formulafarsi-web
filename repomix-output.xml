COPY config ./config
COPY static ./static
COPY templates ./templates
COPY manage.py ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-editable


FROM python:3.13-slim-bookworm AS runtime

