<file path="pyproject.toml">
[project]
name = "formulafarsi-web"
version = "0.1.0"
description = "Formula Farsi Web Application"
readme = "README.md"
requires-python = ">=3.13"
dependencies = [
    "django>5.2,<5.3",
    "django-environ>=0.14.0",
    "django-summernote>=0.8.20.0",
    "django-unfold>=0.110.1",
    "gunicorn>=27.0.1",
    "jdatetime>=6.1.1",
    "pillow>=13.0.0",
    "psycopg[binary]>=3.3.9",
    "python-dotenv>=1.2.4",
    "whitenoise>=6.12.0",
]

[dependency-groups]
dev = [
    "django-debug-toolbar>=8.0.0",
    "django-extensions>=4.1",
    "factory-boy>=3.3.3",
    "faker>=40.54.0",
    "pytest>=9.2.0",
    "pytest-cov>=7.1.0",
    "pytest-django>=4.14.0",
    "pytest-xdist>=3.8.0",
    "watchfiles>=1.3.0",
    "werkzeug>=3.1.9",
]

[tool.pytest.ini_options]
DJANGO_SETTINGS_MODULE = "config.settings.test"
python_files = ["test_*.py", "*_test.py", "tests.py"]
addopts = "--reuse-db"

[tool.ruff.lint.per-file-ignores]
"config/settings/*.py" = ["F403", "F405"]
</file>

<file path="templates/base.html">
{% load static %}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}فرمولافارسی{% endblock %}</title>
    <!-- استایل‌های سریع Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- فونت Vazirmatn -->
    <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet" type="text/css" />
    <style>
        body { font-family: 'Vazirmatn', sans-serif; }
    </style>
</head>
<body class="bg-zinc-950 text-zinc-100 min-h-screen flex flex-col justify-between antialiased">

    <!-- هدر سایت -->
    <header class="border-b border-zinc-800 bg-zinc-900/90 backdrop-blur sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
            
            <div class="flex items-center gap-6">
                <!-- دکمه همبرگری مخصوص موبایل -->
                <button id="mobile-menu-btn" type="button" aria-label="منوی سایت" class="md:hidden p-2 text-zinc-400 hover:text-white hover:bg-zinc-800 rounded-lg transition focus:outline-none">
                    <svg class="w-6 h-6 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>

                <!-- لوگوی سایت -->
                <a href="{% url 'news:home' %}" class="flex items-center select-none">
                    <img src="{% static 'images/FormulaFarsi_Logo.png' %}" alt="فرمولافارسی" class="h-7 md:h-8 w-auto object-contain">
                </a>

                <!-- منوی دسکتاپ -->
                <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-zinc-300">
                    <a href="{% url 'news:home' %}" class="hover:text-red-500 transition">صفحه اصلی</a>
                    <a href="{% url 'news:articles_list' %}" class="hover:text-red-500 transition">اخبار</a>
                    <a href="{% url 'racing:standings' %}" class="hover:text-red-500 transition">جدول رده‌بندی</a>
                    <a href="{% url 'grandprix_calendar:calendar_list' %}" class="hover:text-red-500 transition">تقویم مسابقات</a>
                    <a href="{% url 'racing:drivers_list' %}" class="hover:text-red-500 transition">رانندگان</a>
                    <a href="{% url 'racing:teams_list' %}" class="hover:text-red-500 transition">تیم‌ها</a>
                </nav>
            </div>
            <!-- فیلد جستجوی سراسری در هدر (مخصوص دسکتاپ) -->
            <form method="GET" action="{% url 'news:global_search' %}" class="hidden md:flex items-center w-64 lg:w-72">
                <div class="relative w-full">
                    <input type="text" name="q" value="{{ search_query|default:'' }}"
                           placeholder="جستجوی راننده، تیم، مسابقه، خبر..."
                           class="w-full bg-zinc-950/90 border border-zinc-800 text-xs text-zinc-200 rounded-xl pr-3.5 pl-9 py-2 focus:outline-none focus:border-red-600 transition placeholder:text-zinc-500">
                    <button type="submit" aria-label="جستجو" class="absolute left-2.5 top-1/2 -translate-y-1/2 text-zinc-400 hover:text-red-500 transition">
                        <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.15 12.15z" />
                        </svg>
                    </button>
                </div>
            </form>
        </div>
    </header>

    <!-- لایه تاریک پس‌زمینه در موبایل (Backdrop) -->
    <div id="drawer-backdrop" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 hidden transition-opacity duration-300 opacity-0 md:hidden"></div>

    <!-- منوی کشویی جانبی (Mobile Drawer) -->
