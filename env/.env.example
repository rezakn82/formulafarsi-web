# ==============================================================================
# FormulaFarsi Shared Base Environment Example (Optional)
# ==============================================================================
# Environment-specific configuration belongs in:
#   - env/.env.local       (copied from env/.env.local.example)
#   - env/.env.production  (copied from env/.env.production.example)
#
# Use env/.env only for non-secret settings shared across environments
# (overridden by env/.env.<profile> and OS process environment variables).
# ==============================================================================

# Localization
LANGUAGE_CODE=fa-ir
TIME_ZONE=Asia/Tehran

# Static & Media URLs
STATIC_URL=/static/
MEDIA_URL=/media/
