# ==============================================================================
# FormulaFarsi Environment Configuration Example
# Copy this file to env/.env and adjust values for your environment.
# ==============================================================================

# Environment name (local | docker | production)
DJANGO_ENV=local

# Core Security Settings
SECRET_KEY=replace-me-with-a-secure-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database Configuration (sqlite:///path or postgres://user:pass@host:5432/dbname)
# Leave commented out in local development to use BASE_DIR / db.sqlite3 by default.
# DATABASE_URL=sqlite:///db.sqlite3

# Localization
LANGUAGE_CODE=en-us
TIME_ZONE=Asia/Tehran

# Static & Media URLs
STATIC_URL=/static/
MEDIA_URL=/media/

# Email Backend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
