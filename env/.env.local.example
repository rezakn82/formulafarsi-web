# ==============================================================================
# FormulaFarsi Local Development Environment Example
# Copy this file to env/.env.local and adjust values for local development.
# ==============================================================================

DJANGO_ENV=local

# Core Security & Debug Settings
SECRET_KEY=replace-me-with-a-local-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
INTERNAL_IPS=127.0.0.1,localhost

# Database Configuration (leave commented out to default to BASE_DIR / db.sqlite3)
# DATABASE_URL=sqlite:///db.sqlite3

# Localization
LANGUAGE_CODE=fa-ir
TIME_ZONE=Asia/Tehran

# Static & Media URLs
STATIC_URL=/static/
MEDIA_URL=/media/

# Email Backend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
