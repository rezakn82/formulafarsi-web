# ==============================================================================
# FormulaFarsi Docker Container Environment Example (PostgreSQL + Gunicorn)
# Copy this file to env/.env.docker when running Docker Compose locally.
# ==============================================================================

DJANGO_ENV=docker
DJANGO_SETTINGS_MODULE=config.settings.docker

# Core Security & Hosts
SECRET_KEY=replace-me-with-a-docker-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ADMIN_URL=admin/

# PostgreSQL Service & Django Database URL
POSTGRES_DB=formulafarsi
POSTGRES_USER=formulafarsi
POSTGRES_PASSWORD=formulafarsi
DATABASE_URL=postgres://formulafarsi:formulafarsi@db:5432/formulafarsi
DB_CONN_MAX_AGE=60

# Container HTTP / Reverse-Proxy Flags (set True when behind HTTPS reverse proxy)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Localization & Paths
LANGUAGE_CODE=fa-ir
TIME_ZONE=Asia/Tehran
STATIC_URL=/static/
MEDIA_URL=/media/
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media

# Email & Logging
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_LOG_LEVEL=INFO
